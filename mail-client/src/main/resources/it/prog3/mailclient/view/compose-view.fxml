<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Finestra di composizione: nuovo messaggio, risposta, risposta a tutti, inoltro. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.prog3.mailclient.controller.ComposeController"
      stylesheets="@client.css"
      spacing="10" prefWidth="620" prefHeight="480">
    <padding>
        <Insets top="12" right="14" bottom="12" left="14"/>
    </padding>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="60"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="A:" styleClass="bold" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="toField" promptText="nome@dominio.it, altro@dominio.it"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Oggetto:" styleClass="bold" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="subjectField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <TextArea fx:id="bodyArea" wrapText="true" VBox.vgrow="ALWAYS"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <ProgressIndicator fx:id="progressIndicator" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Annulla" cancelButton="true" onAction="#onCancel" prefWidth="90"/>
        <Button fx:id="sendButton" text="Invia" onAction="#onSend" prefWidth="90" styleClass="primary"/>
    </HBox>
</VBox>
