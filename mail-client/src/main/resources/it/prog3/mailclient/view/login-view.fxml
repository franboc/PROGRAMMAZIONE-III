<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Schermata di accesso: l'unica forma di autenticazione è l'indirizzo email. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.prog3.mailclient.controller.LoginController"
      stylesheets="@client.css"
      alignment="CENTER" spacing="12" prefWidth="420" prefHeight="300">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Mail Client" styleClass="title"/>
    <Label text="Inserisci il tuo indirizzo email per accedere"/>

    <TextField fx:id="emailField" promptText="nome@dominio.it" maxWidth="320"/>

    <HBox alignment="CENTER" spacing="10">
        <!-- defaultButton="true": premere Invio equivale a cliccare il bottone -->
        <Button fx:id="loginButton" text="Accedi" defaultButton="true" onAction="#onLogin" prefWidth="100"/>
        <ProgressIndicator fx:id="progressIndicator" prefWidth="22" prefHeight="22" visible="false"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="320"/>
</VBox>
