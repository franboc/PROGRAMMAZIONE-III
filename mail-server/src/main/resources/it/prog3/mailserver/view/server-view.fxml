<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>

<!-- VIEW del server: descrive SOLO l'aspetto, nessuna logica.
     fx:controller indica quale classe gestisce questa vista. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.prog3.mailserver.controller.ServerController"
            prefWidth="700" prefHeight="450">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <Label text="Log eventi" style="-fx-font-size: 16; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets bottom="8"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <ListView fx:id="logListView"/>
    </center>
</BorderPane>
